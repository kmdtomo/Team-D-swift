{
  "openapi": "3.1.0",
  "info": {"title": "Team-D shared backend contract", "version": "1.0.0"},
  "paths": {
    "/api/health": {"get": {"x-team-d-availability": "implemented", "x-team-d-timeout-seconds": 5, "x-team-d-retry": "safe-caller-retry", "x-team-d-idempotency": "none", "responses": {"200": {"description": "Health", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Health"}}}}}}},
    "/api/livekit-token": {"post": {"x-team-d-availability": "implemented", "x-team-d-timeout-seconds": 10, "x-team-d-retry": "explicit-only-new-identity", "x-team-d-idempotency": "none", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TokenRequest"}}}}, "responses": {"200": {"description": "Token", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TokenResponse"}}}}, "422": {"description": "Source-native FastAPI validation", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TokenValidationError"}}}}, "503": {"description": "Source-native unavailable", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TokenError"}}}}}}},
    "/api/analyze-shot": {"post": {"x-team-d-availability": "unavailable", "x-team-d-timeout-seconds": 20, "x-team-d-retry": "caller-may-retry-documented-failures", "x-team-d-timeout-retryable": true, "x-team-d-idempotency": "required-stable-per-operation", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"required": true, "content": {"multipart/form-data": {"schema": {"$ref": "#/components/schemas/AnalyzeRequest"}, "encoding": {"requestedShot": {"contentType": "text/plain"}, "image": {"contentType": "image/jpeg, image/png, image/heic"}}}}}, "responses": {"200": {"description": "Assessment", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ShotAssessment"}}}}, "400": {"$ref": "#/components/responses/ProviderError"}, "415": {"$ref": "#/components/responses/ProviderError"}, "422": {"$ref": "#/components/responses/ProviderError"}, "429": {"$ref": "#/components/responses/ProviderError"}, "502": {"$ref": "#/components/responses/ProviderError"}, "503": {"$ref": "#/components/responses/ProviderError"}, "504": {"$ref": "#/components/responses/ProviderError"}}}},
    "/api/suggest-measurement-points": {"post": {"x-team-d-availability": "unavailable", "x-team-d-timeout-seconds": 20, "x-team-d-retry": "caller-may-retry-documented-failures", "x-team-d-timeout-retryable": true, "x-team-d-idempotency": "required-stable-per-operation", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"required": true, "content": {"multipart/form-data": {"schema": {"$ref": "#/components/schemas/ImageRequest"}, "encoding": {"image": {"contentType": "image/jpeg, image/png, image/heic"}}}}}, "responses": {"200": {"description": "Four points only", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/MeasurementPoints"}}}}, "400": {"$ref": "#/components/responses/ProviderError"}, "415": {"$ref": "#/components/responses/ProviderError"}, "422": {"$ref": "#/components/responses/ProviderError"}, "429": {"$ref": "#/components/responses/ProviderError"}, "502": {"$ref": "#/components/responses/ProviderError"}, "503": {"$ref": "#/components/responses/ProviderError"}, "504": {"$ref": "#/components/responses/ProviderError"}}}},
    "/api/generate-background": {"post": {"x-team-d-availability": "unavailable", "x-team-d-timeout-seconds": 60, "x-team-d-retry": "caller-may-retry-documented-failures", "x-team-d-timeout-retryable": true, "x-team-d-idempotency": "required-stable-per-operation", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/BackgroundRequest"}}}}, "responses": {"200": {"description": "Source-free background PNG", "content": {"image/png": {}}}, "400": {"$ref": "#/components/responses/ProviderError"}, "415": {"$ref": "#/components/responses/ProviderError"}, "422": {"$ref": "#/components/responses/ProviderError"}, "429": {"$ref": "#/components/responses/ProviderError"}, "502": {"$ref": "#/components/responses/ProviderError"}, "503": {"$ref": "#/components/responses/ProviderError"}, "504": {"$ref": "#/components/responses/ProviderError"}}}},
    "/api/remove-background": {"post": {"x-team-d-availability": "unavailable", "x-team-d-timeout-seconds": 35, "x-team-d-retry": "caller-may-retry-documented-failures", "x-team-d-timeout-retryable": true, "x-team-d-idempotency": "required-stable-per-operation", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"required": true, "content": {"multipart/form-data": {"schema": {"$ref": "#/components/schemas/ImageRequest"}, "encoding": {"image": {"contentType": "image/jpeg, image/png, image/heic"}}}}}, "responses": {"200": {"description": "Same-dimension original-front mask-only PNG", "content": {"image/png": {}}}, "400": {"$ref": "#/components/responses/ProviderError"}, "415": {"$ref": "#/components/responses/ProviderError"}, "422": {"$ref": "#/components/responses/ProviderError"}, "429": {"$ref": "#/components/responses/ProviderError"}, "502": {"$ref": "#/components/responses/ProviderError"}, "503": {"$ref": "#/components/responses/ProviderError"}, "504": {"$ref": "#/components/responses/ProviderError"}}}}
  },
  "components": {
    "parameters": {"IdempotencyKey": {"name": "Idempotency-Key", "in": "header", "required": true, "schema": {"type": "string", "minLength": 1, "maxLength": 128}}},
    "responses": {"ProviderError": {"description": "Planned endpoint error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProviderError"}}}}},
    "schemas": {
      "Health": {"type": "object", "additionalProperties": false, "required": ["status"], "properties": {"status": {"const": "ok"}}},
      "TokenRequest": {"type": "object", "additionalProperties": false, "required": ["sessionId"], "properties": {"sessionId": {"type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,95}$"}}},
      "TokenResponse": {"type": "object", "additionalProperties": false, "required": ["token", "participantIdentity", "roomName", "expiresAt", "livekitUrl"], "properties": {"token": {"type": "string", "minLength": 1}, "participantIdentity": {"type": "string", "minLength": 1}, "roomName": {"type": "string", "minLength": 1}, "expiresAt": {"type": "integer", "minimum": 1}, "livekitUrl": {"type": "string", "pattern": "^(wss|https)://"}}},
      "TokenError": {"type": "object", "additionalProperties": false, "required": ["detail"], "properties": {"detail": {"type": "string", "minLength": 1}}},
      "TokenValidationError": {"oneOf": [{"$ref": "#/components/schemas/TokenError"}, {"type": "object", "additionalProperties": false, "required": ["detail"], "properties": {"detail": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["type", "loc", "msg"], "properties": {"type": {"type": "string", "minLength": 1}, "loc": {"type": "array", "minItems": 1, "items": {"oneOf": [{"type": "string"}, {"type": "integer"}]}}, "msg": {"type": "string", "minLength": 1}, "input": {}, "ctx": {"type": "object"}}}}}}]},
      "ImageRequest": {"type": "object", "additionalProperties": false, "required": ["image"], "properties": {"image": {"type": "string", "format": "binary"}}},
      "AnalyzeRequest": {"type": "object", "additionalProperties": false, "required": ["requestedShot", "image"], "properties": {"requestedShot": {"type": "string", "enum": ["front", "back", "tag"]}, "image": {"type": "string", "format": "binary"}}},
      "Point": {"type": "object", "additionalProperties": false, "required": ["x", "y"], "properties": {"x": {"type": "number", "minimum": 0, "maximum": 1}, "y": {"type": "number", "minimum": 0, "maximum": 1}}},
      "MeasurementPoints": {"type": "object", "additionalProperties": false, "required": ["lengthStart", "lengthEnd", "widthStart", "widthEnd"], "properties": {"lengthStart": {"$ref": "#/components/schemas/Point"}, "lengthEnd": {"$ref": "#/components/schemas/Point"}, "widthStart": {"$ref": "#/components/schemas/Point"}, "widthEnd": {"$ref": "#/components/schemas/Point"}}},
      "ShotAssessment": {"type": "object", "additionalProperties": false, "required": ["shotType", "quality", "issues", "missingShots", "nextAction"], "properties": {"shotType": {"type": "string", "enum": ["front", "back", "tag", "unknown"]}, "quality": {"type": "string", "enum": ["ok", "retry"]}, "issues": {"type": "array", "items": {"type": "string", "enum": ["TOO_DARK", "TOO_BRIGHT", "TOO_BLURRY", "BLURRY", "GARMENT_CROPPED", "TAG_UNREADABLE", "WRONG_SHOT"]}}, "missingShots": {"type": "array", "items": {"type": "string", "enum": ["front", "back", "tag"]}}, "nextAction": {"type": "string", "enum": ["RETAKE", "REQUEST_NEXT", "COMPLETE"]}}},
      "BackgroundRequest": {"type": "object", "additionalProperties": false, "required": ["styleId"], "properties": {"styleId": {"type": "string", "minLength": 1, "maxLength": 128}}},
      "ProviderError": {"$ref": "schemas/provider-error.schema.json"}
    }
  }
}
